# =====================================================================
#  hong-coach 部署环境变量
#
#  用法：cp .env.example .env  然后改掉里面的密码。
#  .env 已被 .gitignore 和 .dockerignore 排除，不会提交、也不会打进镜像。
# =====================================================================

# ---------- 数据库 ----------
DB_NAME=chess_coach_db
DB_USER=chess
# 改成强密码。下面两个都用单引号或直接写，别带 # 号（会被当注释）
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
DB_POOL_SIZE=8

# ---------- 对外访问 ----------
# 宿主机上暴露的端口。80 被占用或想走 Nginx 反代时改这里
APP_PORT=8080

# ---------- AI 教练 ----------
# 用哪一家的大模型：deepseek（默认）| dashscope（阿里云百炼）| none（完全不用大模型）
COACH_PROVIDER=deepseek

# DeepSeek 开放平台的 key，申请地址：https://platform.deepseek.com/
# 模型可选 deepseek-flash（快、便宜，适合教练这种一两百字的短点评）
# 或 deepseek-v4-pro（棋理分析更细，贵约 4 倍）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 思考量。none = 不思考（默认），正文立刻开始吐。
# 引擎已经把棋算完了，模型只负责把结论翻译成人话，让它再推演一遍纯属浪费：
# 实测同一个提问，不关思考首字要等 4.7~8.3 秒，关掉后 0.4~0.5 秒。
# 想让它重新推演（点评细节会多些）就设成 low / high / max，代价是首字重新变慢。
COACH_REASONING_EFFORT=none

# 阿里云百炼（DashScope）的 key，申请地址：https://bailian.console.aliyun.com/
# 只有把 COACH_PROVIDER 设成 dashscope 时才会用到
DASHSCOPE_API_KEY=

# 【留空完全可以】上面两个 key 都留空时，应用会自动把大模型关掉（见 config/CoachLlmConfig），
# 教练改用本地规则提示，不发起任何大模型请求。下棋、引擎复盘、悔棋、摆棋都不受影响。
# 反过来若按当前 COACH_PROVIDER 填了对应的 key，教练就是真人陪练口吻的讲解。

# 走 Spring AI 的那条路（百炼）的 HTTP 超时（毫秒）。
# 读超时 = 「服务端 N 秒不吐字就断开」，必须大于模型的首字延迟，否则每次调用都会被误判成失败。
# 见 config/LlmHttpClientConfig：不显式设置的话，classpath 上的 OkHttp 会让它退化成 10 秒。
COACH_HTTP_READ_TIMEOUT_MS=120000
COACH_HTTP_CONNECT_TIMEOUT_MS=10000

# DeepSeek 到「响应头」为止的超时（毫秒），含 TLS 握手和服务端的排队/首字时间。
# 它不会误伤流式传输中途的正常停顿 —— 那种停顿由下面的 COACH_TIMEOUT_MS 管，
# 而且能区分「首字没来」和「吐到一半卡住」。
COACH_FIRST_BYTE_TIMEOUT_MS=30000
# 讲解是流式推给浏览器的，超时分两层：
# - COACH_TIMEOUT_MS = 「两段输出之间最多停顿多久」，从发出请求就开始计时，
#   所以首字迟迟不来也会被它抓到，超了立刻给本地提示。
# - COACH_STREAM_MAX_MS = 一整条流最多持续多久，到点收尾（管的是「模型一直在慢慢吐」）。
COACH_TIMEOUT_MS=40000
COACH_STREAM_MAX_MS=180000

# ---------- 象棋引擎 ----------
# 引擎进程池大小 = 能同时服务几局。每个实例约占一个 CPU 核，
# 小机器（2 核）建议设 1~2，否则同时下棋会排队。
ENGINE_POOL_SIZE=2
